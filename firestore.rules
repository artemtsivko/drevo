rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Профілі: кожен читає публічні, редагує лише свій
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Люди: власник має повний доступ на запис.
    // Читання дозволене будь-якому автентифікованому користувачу — це потрібно для
    // фонового автопошуку збігів між деревами, включно з приватними.
    // Застереження: додаток НЕ показує в інтерфейсі повний чужий родовід без grant —
    // лише короткий контекст (ім'я, рік, 2-3 звʼязки) у картці пропозиції об'єднання.
    // Це UI-обмеження, не обмеження бази даних.
    match /people/{personId} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow read: if request.auth != null;
    }

    // Запити доступу
    match /accessRequests/{id} {
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;
      allow read, update: if request.auth != null && (
        resource.data.fromUid == request.auth.uid
        || resource.data.toUid == request.auth.uid
      );
    }

    // Надані доступи
    match /grants/{id} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.ownerId == request.auth.uid
        || resource.data.granteeUid == request.auth.uid
      );
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // Пропозиції об'єднання
    match /mergeProposals/{id} {
      allow create: if request.auth != null
        && request.resource.data.initiatorUid == request.auth.uid;
      allow read, update: if request.auth != null && (
        resource.data.initiatorUid == request.auth.uid
        || resource.data.respondentUid == request.auth.uid
      );
    }

  }
}
