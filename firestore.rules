rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Профілі користувачів
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Family Spaces: спільний простір редагування. Членство визначає, хто може
    // редагувати людей, що йому належать (people.spaceId == цей простір).
    match /familySpaces/{spaceId} {
      allow read: if request.auth != null;
      // Створити можна лише простір, де я сам є єдиним чи одним із members.
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members;
      // Оновлювати (додавати/прибирати учасників) може будь-хто, хто ВЖЕ є учасником —
      // це потрібно і для прийняття обʼєднання (toSpace-сторона додає учасників fromSpace),
      // і для виходу (learFamilySpace прибирає себе).
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members;
      // Видалити можна лише простір, де я є учасником.
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.members;
    }

    // Люди: право редагування визначається належністю uid до spaceMembers того простору,
    // якому належить документ (people.spaceId -> familySpaces/{spaceId}.members).
    match /people/{personId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/familySpaces/$(request.resource.data.spaceId)).data.members;
      allow update: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/familySpaces/$(resource.data.spaceId)).data.members;
      allow delete: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/familySpaces/$(resource.data.spaceId)).data.members;
    }

    // Пропозиції об'єднання просторів
    match /spaceMergeProposals/{id} {
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;
      allow read: if request.auth != null;
      // Оновлювати (прийняти/відхилити) може будь-хто автентифікований, хто є учасником
      // toSpace (той, кому пропозицію адресовано) — перевіряємо через сам toSpaceId.
      allow update: if request.auth != null && (
        request.auth.uid in get(/databases/$(database)/documents/familySpaces/$(resource.data.toSpaceId)).data.members
        || request.auth.uid == resource.data.fromUid
      );
    }
  }
}
